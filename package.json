{
  "name": "repair-app-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "host:start": "npm run start -w apps/host",
    "host:build": "npm run build -w apps/host",
    "host:typecheck": "npm run typecheck -w apps/host",
    "admin:start": "npm run start -w apps/admin",
    "admin:build": "npm run build -w apps/admin",
    "admin:typecheck": "npm run typecheck -w apps/admin",
    "api:start": "npm run start -w api",
    "api:build": "npm run build -w api",
    "predev": "kill-port 3000 3001 9119",
    "dev": "concurrently -k -n api,admin,host -c blue,magenta,green \"npm run api:start\" \"npm run admin:start\" \"wait-on http://localhost:3001/remoteEntry.js && npm run host:start\"",
    "build": "npm run api:build && npm run host:build && npm run admin:build",
    "typecheck": "npm run host:typecheck && npm run admin:typecheck",
    "test:host": "npm run test -w apps/host",
    "test": "npm run test:host"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11"
    "@ungap/structured-clone": "^1.3.1",
    "concurrently": "^10.0.0",
    "kill-port": "^2.0.1",
    "wait-on": "^9.0.10"
  }
}
