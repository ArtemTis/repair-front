# Локальная разработка (npm run dev): БД из docker compose up db -d
DB_HOST=localhost
DB_PORT=5433

# Внутри Docker (docker compose up): переопределяется в docker-compose.yml
# DB_HOST=db
# DB_PORT=5432
DB_NAME=node_postgres
DB_USER=postgres
DB_PASSWORD=root

PORT=9119


JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false